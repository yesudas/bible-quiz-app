admin-credentials.php
share-secret.php
leaderboard-secret.php

# Site-specific analytics tag (copy google-analytics.example.php to google-analytics.php)
/google-analytics.php


# Site counters are live server data (edited on the server, never deployed via git);
# only the .htaccess guard is tracked.
counters/*
!counters/.htaccess
bot.log
pdf-temp/*.pdf
# Pre-generated static PDFs (tools/generate-quiz-pdfs.py output) — large,
# binary, and regenerable locally; uploaded to the server directly, never
# via git.
/pdf/

.DS_Store
**/.DS_Store
leaderboard/top10.json
leaderboard/all.json

sync.ffs_lock
.sync.ffs_db*

# Everything under logs/ is private runtime data (reports, leaderboard master file, per-user
# thank-you notices keyed by hashed email); only the .htaccess guard is tracked.
logs/*
!logs/.htaccess
